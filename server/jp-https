#!/usr/bin/env python3
# HTTPS front for networks that block ssh (a corp VPN): Cloudflare -> nginx location /jpsnap/ -> 127.0.0.1:8893 -> here.
# POST /translate and POST /tts take the same bodies as the ssh forced command's stdin and return its stdout.
# Auth: "Authorization: Bearer <token>", token in ~/.config/jpsnap/https_token (one line, 32+ chars, chmod 600).
#   jp-https          serve (systemd unit jpsnap-https.service)
#   jp-https selftest auth, routing and limits on a random local port; no codex, no network
import hmac, os, signal, subprocess, sys, tempfile, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
CORE = os.path.join(HERE, "..", "jpsnap_core.py")
PYTHON = os.path.expanduser("~/.local/share/jpsnap-venv/bin/python")
TOKEN_FILE = os.path.expanduser("~/.config/jpsnap/https_token")
MODES = {"/translate": "translate", "/tts": "tts"}
MAX_BODY = 30_000_000  # base64 of a full-screen PNG fits easily
SLOTS = threading.BoundedSemaphore(6)  # core runs at once; more get 503 instead of piling up codex processes
TIMEOUT = 170  # under nginx's proxy_read_timeout


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    timeout = 60  # a client that stops sending frees its thread
    token = b""
    env = dict(os.environ, JPSNAP_CODEX=os.environ.get("JPSNAP_CODEX") or os.path.expanduser("~/.local/bin/codex"))

    def reply(self, code, body, ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        auth = self.headers.get("Authorization", "").encode("latin-1")  # http.server decodes headers as latin-1
        if not self.token or not hmac.compare_digest(auth, b"Bearer " + self.token):
            self.close_connection = True  # body not read
            return self.reply(401, b"Unauthorized")
        mode = MODES.get(self.path)
        try:
            size = int(self.headers.get("Content-Length", ""))
        except ValueError:
            size = -1
        if not mode or not 0 < size <= MAX_BODY:
            self.close_connection = True
            return self.reply(404 if not mode else 413, b"Not found" if not mode else b"Body missing or too large")
        body = self.rfile.read(size)
        if not SLOTS.acquire(blocking=False):
            return self.reply(503, b"Server busy, try again")
        try:
            code, out, err = run_core(mode, body, self.env, TIMEOUT)
        finally:
            SLOTS.release()
        if code is None:
            return self.reply(504, b"Timed out")
        if code:  # short core message; not 502, Cloudflare swaps 502 bodies for its own page
            return self.reply(422, err[-2000:] or b"Failed")
        self.reply(200, out, "application/json; charset=utf-8")

    def do_GET(self):
        self.close_connection = True
        self.reply(404, b"Not found")


def run_core(mode, body, env, timeout, cmd=None):
    """-> (exit code or None on timeout, stdout, stderr). The core runs in its own process group, so a timeout
    also kills the codex it started and the slot limit stays true."""
    p = subprocess.Popen(cmd or [PYTHON, "-I", CORE, mode], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, env=env, start_new_session=True)
    try:
        out, err = p.communicate(body, timeout=timeout)
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        return None, b"", b""


def serve(port=8893):
    with open(TOKEN_FILE, "rb") as f:
        Handler.token = f.read().strip()
    if len(Handler.token) < 32:
        sys.exit("token in %s is missing or shorter than 32 chars" % TOKEN_FILE)
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


def selftest():
    import http.client
    Handler.token = b"t" * 40
    srv = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    def post(path, body=b"x", token="t" * 40, size=None):
        c = http.client.HTTPConnection("127.0.0.1", srv.server_address[1], timeout=60)
        headers = {"Authorization": "Bearer " + token} if token is not None else {}
        headers["Content-Length"] = str(len(body) if size is None else size)
        c.request("POST", path, body=body, headers=headers)
        r = c.getresponse()
        return r.status, r.read()

    assert post("/translate", token=None)[0] == 401
    assert post("/translate", token="t" * 39)[0] == 401
    assert post("/translate", token="t" * 40 + "x")[0] == 401
    assert post("/nope")[0] == 404
    assert post("/translate", b"", size=MAX_BODY + 1)[0] == 413
    code, text = post("/translate", b"not a header\nAAAA")  # reaches the core, which refuses it
    assert code == 422 and b"Bad request header" in text, (code, text)
    srv.shutdown()
    # a timed-out core loses its children too (codex runs as one)
    with tempfile.NamedTemporaryFile("r") as pidfile:
        code, _, _ = run_core("", b"", {}, 1, ["sh", "-c", 'sleep 30 & echo $! > "$0"; wait', pidfile.name])
        child = int(pidfile.read())
    assert code is None
    for _ in range(50):  # the orphaned child is reaped by init shortly after the kill
        try:
            os.kill(child, 0)
            time.sleep(0.1)
        except ProcessLookupError:
            break
    else:
        raise AssertionError("child %d survived the timeout" % child)
    print("selftest ok")


if __name__ == "__main__":
    selftest() if sys.argv[1:] == ["selftest"] else serve()
