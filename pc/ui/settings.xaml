<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JpSnap settings" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13" Foreground="#F0F0F0">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4"/><Setter Property="Opacity" Value="0.7"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Opacity" Value="0.5"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Field" TargetType="Control">
      <Setter Property="Background" Value="#2A2A30"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="BorderBrush" Value="#50FFFFFF"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Field}"><Setter Property="CaretBrush" Value="#F0F0F0"/></Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}"><Setter Property="CaretBrush" Value="#F0F0F0"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="Margin" Value="0,0,18,0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F0F0F0"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="MinWidth" Value="84"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="#30FFFFFF" CornerRadius="6" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsDefault" Value="True"><Setter TargetName="b" Property="Background" Value="#3D8BFD"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Border CornerRadius="12" Background="#1B1B1F">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55"/></Border.Effect>
    </Border>
    <Border x:Name="root" CornerRadius="12" Background="#FA1B1B1F" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="20,14,20,18">
      <StackPanel Width="380">
        <TextBlock Text="JpSnap settings" FontSize="17" FontWeight="SemiBold"/>

        <TextBlock Text="Translate on" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="runServer" GroupName="run" Content="Server (ssh)"/>
          <RadioButton x:Name="runPc" GroupName="run" Content="This PC"/>
        </StackPanel>

        <TextBlock Text="Server (user@host)" Style="{StaticResource Label}"/>
        <TextBox x:Name="server" AutomationProperties.Name="Server (user@host)"/>

        <TextBlock Text="OpenAI API key (optional)" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="apiKey" AutomationProperties.Name="OpenAI API key (optional)"/>
        <TextBlock x:Name="keyState" Style="{StaticResource Note}"/>
        <CheckBox x:Name="removeKey" Content="Remove the saved key" Margin="0,4,0,0" Visibility="Collapsed"/>

        <TextBlock Text="Speed" Style="{StaticResource Label}"/>
        <CheckBox x:Name="fast" Content="Fast mode: quick translation first (~10 s), details follow"/>
        <TextBlock Text="Runs a quick and a full lookup at the same time, so each snip uses two requests." Style="{StaticResource Note}"/>

        <TextBlock Text="Windows" Style="{StaticResource Label}"/>
        <CheckBox x:Name="autoStart" Content="Start with Windows (Ctrl+Alt+J always ready)"/>

        <TextBlock Text="Voice" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="voiceNanami" GroupName="voice" Content="Nanami (female)"/>
          <RadioButton x:Name="voiceKeita" GroupName="voice" Content="Keita (male)"/>
        </StackPanel>

        <TextBlock Text="Speech speed" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="speedNormal" GroupName="speed" Content="Normal"/>
          <RadioButton x:Name="speedSlow" GroupName="speed" Content="Slow"/>
        </StackPanel>

        <TextBlock x:Name="error" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="cancelSettings" Content="Cancel" IsCancel="True"/>
          <Button x:Name="saveSettings" Content="Save" IsDefault="True"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
